# APD Studio — environment template. Copy to .env.local. Never commit .env.
# There is NO CMS endpoint here, and there never will be. The product exports
# packages for a named human to file. See ADR-0004.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

DATABASE_URL=postgresql://localhost:5432/apd_studio

# Row-level security is enforced in the database, not the app. See ADR-0003.
DATABASE_APP_ROLE=apd_app

NODE_ENV=development
